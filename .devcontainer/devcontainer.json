// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/rust
{
	"name": "Notes",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/rust:2-1-trixie",
	"features": {
		// My standard tooling: Claude Code, the GitHub CLI, OpenCode and
		// Wrangler (for site/), with logins in volumes shared by all my
		// devcontainers (`dev-setup logins` lists the login commands), plus
		// SSH commit signing. Private package: the host needs
		// `docker login ghcr.io`.
		"ghcr.io/etiennedelange/devcontainer-features/dev-setup:1": {
			"opencode": true,
			"wrangler": true
		},
		"ghcr.io/devcontainers/features/node:2": {
			"version": "lts"
		}
	},

	"postCreateCommand": "bash .devcontainer/post-create.sh",

	// Persist the cargo cache in a per-container Docker volume across
	// rebuilds. (OpenCode's state volume comes from dev-setup.)
	"mounts": [
		{
			"source": "devcontainer-cargo-cache-${devcontainerId}",
			"target": "/usr/local/cargo",
			"type": "volume"
		}
	]

	// Features to add to the dev container. More info: https://containers.dev/features.
	// "features": {},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// 1420: the Tauri app's Vite dev server (`pnpm dev` at the repo root).
	// 4322: the Astro marketing site's dev server (`pnpm dev` in site/).
	// 8976: `wrangler login`'s OAuth callback.
	"forwardPorts": [1420, 4322, 8976],

	// Configure tool-specific properties.
	// "customizations": {},

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
