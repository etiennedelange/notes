---
import { formatBytes, RELEASES_URL, REPO_URL, type ReleaseInfo } from "../lib/github";

interface Props {
  release: ReleaseInfo | null;
}

const { release } = Astro.props;
---

<section class="section" id="download">
  <div class="section-inner">
    <h2 class="heading">Download</h2>

    {
      release ? (
        <>
          <p class="lede">
            <span class="version">{release.tag}</span>
            {release.publishedAt && (
              <span class="date">
                released{" "}
                {new Date(release.publishedAt).toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })}
              </span>
            )}
          </p>

          <div class="platforms">
            {release.platforms.map((p) => (
              <div class="platform">
                <a class="btn btn-primary" href={p.primary.url}>
                  {p.label}
                  <span class="size">{formatBytes(p.primary.size)}</span>
                </a>
                {p.extra.length > 0 && (
                  <p class="extra">
                    also:{" "}
                    {p.extra.map((asset, i) => (
                      <>
                        {i > 0 && ", "}
                        <a href={asset.url}>{asset.name}</a>
                      </>
                    ))}
                  </p>
                )}
              </div>
            ))}
          </div>

          <p class="all-releases">
            <a href={release.url}>See {release.name} notes and every past release on GitHub</a>
          </p>
        </>
      ) : (
        <div class="empty">
          <p class="lede">
            No published release yet — Notes is still pre-1.0 and builds are
            made on demand.
          </p>
          <div class="empty-links">
            <a class="btn btn-primary" href={RELEASES_URL}>
              Check the releases page
            </a>
            <a class="btn btn-ghost" href={`${REPO_URL}#building`}>
              Build it from source
            </a>
          </div>
        </div>
      )
    }
  </div>
</section>

<style>
  .heading {
    font-size: clamp(1.5rem, 3vw, 1.9rem);
    color: var(--paper);
  }

  .lede {
    margin-top: 1rem;
    color: var(--cloud);
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .version {
    font-family: var(--font-mono);
    color: var(--teal);
    font-size: 1.1rem;
  }

  .date {
    font-size: 0.9rem;
  }

  .platforms {
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .platform .btn-primary {
    min-width: 14rem;
    justify-content: space-between;
  }

  .size {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    opacity: 0.75;
  }

  .extra {
    margin-top: 0.6rem;
    font-size: 0.85rem;
    color: var(--cloud);
  }

  .extra a {
    color: var(--paper);
    text-decoration: underline;
    text-decoration-color: rgba(255, 255, 255, 0.3);
  }

  .all-releases {
    margin-top: 2rem;
    font-size: 0.9rem;
  }

  .all-releases a {
    color: var(--cloud);
    text-decoration: underline;
    text-decoration-color: rgba(255, 255, 255, 0.25);
  }

  .empty-links {
    margin-top: 1.75rem;
    display: flex;
    gap: 0.85rem;
    flex-wrap: wrap;
  }
</style>
