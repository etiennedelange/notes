---
// Palette values copied from src/themes.ts, the app's own theme source.
const themes = [
  {
    id: "nord",
    label: "Nord",
    kind: "dark",
    note: "cool and quiet",
    bg: "#2e3440",
    fg: "#eceff4",
    fgMuted: "#9aa7bd",
    accent: "#88c0d0",
  },
  {
    id: "tokyo-night",
    label: "Tokyo Night",
    kind: "dark",
    note: "moody blue-violet",
    bg: "#24283b",
    fg: "#c0caf5",
    fgMuted: "#7982a9",
    accent: "#7aa2f7",
  },
  {
    id: "noctis-lux",
    label: "Noctis Lux",
    kind: "light",
    note: "warm daylight",
    bg: "#fef8ec",
    fg: "#00404a",
    fgMuted: "#6d8788",
    accent: "#0099ad",
  },
];
---

<section class="section" id="themes">
  <div class="section-inner">
    <h2 class="heading">Three themes, switchable live</h2>
    <p class="lede">No restart, no settings file — pick one from the status bar.</p>

    <div class="grid">
      {
        themes.map((t) => (
          <div class={`card card-${t.id}`}>
            <div class="card-lines">
              <span />
              <span />
              <span />
            </div>
            <div class="card-label">
              <span class="name">{t.label}</span>
              <span class="note">
                {t.kind} · {t.note}
              </span>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .heading {
    font-size: clamp(1.5rem, 3vw, 1.9rem);
    color: var(--paper);
  }

  .lede {
    margin-top: 0.75rem;
    color: var(--cloud);
  }

  .grid {
    margin-top: 2.5rem;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .card {
    border-radius: 10px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 9rem;
    border: 1px solid rgba(0, 0, 0, 0.15);
  }

  .card-lines {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .card-lines span {
    display: block;
    height: 7px;
    border-radius: 5px;
    opacity: 0.9;
  }

  .card-lines span:nth-child(1) {
    width: 70%;
  }

  .card-lines span:nth-child(2) {
    width: 45%;
  }

  .card-lines span:nth-child(3) {
    width: 58%;
  }

  /* Per-theme colors, baked into CSS (rather than inline `style`
     attributes) so the page's Content-Security-Policy style-src doesn't
     need to allow inline styles. Keep in sync with the `themes` array
     above if palette values change. */
  .card-nord {
    background: #2e3440;
  }
  .card-nord .card-label {
    color: #eceff4;
  }
  .card-nord .note {
    color: #9aa7bd;
  }
  .card-nord .card-lines span:nth-child(1) {
    background: #9aa7bd;
  }
  .card-nord .card-lines span:nth-child(2) {
    background: #88c0d0;
  }
  .card-nord .card-lines span:nth-child(3) {
    background: #eceff4;
  }

  .card-tokyo-night {
    background: #24283b;
  }
  .card-tokyo-night .card-label {
    color: #c0caf5;
  }
  .card-tokyo-night .note {
    color: #7982a9;
  }
  .card-tokyo-night .card-lines span:nth-child(1) {
    background: #7982a9;
  }
  .card-tokyo-night .card-lines span:nth-child(2) {
    background: #7aa2f7;
  }
  .card-tokyo-night .card-lines span:nth-child(3) {
    background: #c0caf5;
  }

  .card-noctis-lux {
    background: #fef8ec;
  }
  .card-noctis-lux .card-label {
    color: #00404a;
  }
  .card-noctis-lux .note {
    color: #6d8788;
  }
  .card-noctis-lux .card-lines span:nth-child(1) {
    background: #6d8788;
  }
  .card-noctis-lux .card-lines span:nth-child(2) {
    background: #0099ad;
  }
  .card-noctis-lux .card-lines span:nth-child(3) {
    background: #00404a;
  }

  .card-label {
    margin-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    font-family: var(--font-mono);
  }

  .name {
    font-size: 0.85rem;
    font-weight: 600;
  }

  .note {
    font-size: 0.75rem;
  }

  @media (max-width: 40rem) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
