---
import { Picture } from "astro:assets";
import nord from "../assets/screenshots/editor-nord.png";
import tokyoNight from "../assets/screenshots/editor-tokyo-night.png";
import noctisLux from "../assets/screenshots/editor-noctis-lux.png";

// Screenshots come from `pnpm screenshots` at the repo root.
const themes = [
  { id: "nord", label: "Nord", kind: "dark", note: "cool and quiet", shot: nord },
  { id: "tokyo-night", label: "Tokyo Night", kind: "dark", note: "moody blue-violet", shot: tokyoNight },
  { id: "noctis-lux", label: "Noctis Lux", kind: "light", note: "warm daylight", shot: noctisLux },
];
---

<section class="section section--tight-bottom" id="themes">
  <div class="section-inner">
    <h2 class="heading">Three themes, switchable live</h2>
    <p class="lede">No restart, no settings file — pick one from the status bar.</p>

    <div class="grid">
      {
        themes.map((t) => (
          <figure class="card">
            <Picture
              class="shot"
              src={t.shot}
              formats={["avif", "webp"]}
              widths={[480, 960, 1440]}
              sizes="(max-width: 40rem) 100vw, 22rem"
              alt={`Notes in the ${t.label} theme`}
            />
            <figcaption class="card-label">
              <span class="name">{t.label}</span>
              <span class="note">
                {t.kind} · {t.note}
              </span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .heading {
    font-size: clamp(1.5rem, 3vw, 1.9rem);
    color: var(--paper);
  }

  .lede {
    margin-top: 0.75rem;
    color: var(--cloud);
  }

  .grid {
    margin-top: 2.5rem;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .card {
    margin: 0;
  }

  .shot {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 18px 40px -18px rgba(0, 0, 0, 0.6);
  }

  .card-label {
    margin-top: 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    font-family: var(--font-mono);
  }

  .name {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--paper);
  }

  .note {
    font-size: 0.75rem;
    color: var(--cloud);
  }

  @media (max-width: 40rem) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
