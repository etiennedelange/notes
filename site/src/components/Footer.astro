---
import { REPO_URL } from "../lib/github";
---

<footer class="footer">
  <div class="footer-inner">
    <p class="line">
      Notes is free and open source.
      <a href={REPO_URL}>Read the code</a>, file an issue, or send a patch.
    </p>
    <div class="links">
      <a href={REPO_URL}>Source</a>
      <a href={`${REPO_URL}/issues`}>Issues</a>
      <a href={`${REPO_URL}/releases`}>Releases</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: 3rem var(--gutter) 4rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .footer-inner {
    max-width: var(--wide-width);
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
    font-size: 0.9rem;
    color: var(--cloud);
  }

  .line a {
    color: var(--paper);
    text-decoration: underline;
    text-decoration-color: rgba(255, 255, 255, 0.3);
  }

  .links {
    display: flex;
    gap: 1.25rem;
  }

  .links a {
    color: var(--cloud);
    text-decoration: none;
  }

  .links a:hover {
    color: var(--paper);
  }
</style>
