---
import { Picture } from "astro:assets";
import { REPO_URL, type ReleaseInfo } from "../lib/github";
import editorShot from "../assets/screenshots/editor-tokyo-night.png";

interface Props {
  release: ReleaseInfo | null;
}

const { release } = Astro.props;
---

<section class="hero" id="top">
  <div class="hero-inner">
    <p class="kicker">a desktop editor for .txt and .md files</p>
    <h1 class="line">
      point it at a file and start typing.<span class="cursor" aria-hidden="true"
      ></span>
    </h1>
    <p class="sub">
      No vault. No index. No project to set up. Notes opens instantly and gets
      out of the way — built for the files you already have, not a workspace
      it wants to manage for you.
    </p>
    <div class="ctas">
      <a class="btn btn-primary" href="#download">{release ? "Download Notes" : "Get Notes"}</a>
      <a class="btn btn-ghost" href={REPO_URL}>View source</a>
    </div>

    <Picture
      class="shot"
      src={editorShot}
      formats={["avif", "webp"]}
      widths={[720, 1440, 2048]}
      sizes="(max-width: 64rem) 100vw, 64rem"
      alt="Notes in the Tokyo Night theme: a folder tree on the left, four open tabs, and a markdown note with a highlighted Rust code block"
      loading="eager"
      fetchpriority="high"
    />
  </div>
</section>

<style>
  .hero {
    padding: clamp(2rem, 6vw, 3.5rem) var(--gutter) clamp(3rem, 8vw, 5rem);
  }

  .hero-inner {
    max-width: var(--wide-width);
    margin: 0 auto;
  }

  .kicker {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--cloud);
  }

  .line {
    margin-top: 1.1rem;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: clamp(1.9rem, 4.6vw, 3.1rem);
    line-height: 1.3;
    color: var(--paper);
    max-width: 17ch;
    clip-path: inset(0 100% -0.2em 0);
    animation: reveal 1s cubic-bezier(0.16, 0.84, 0.44, 1) 0.25s forwards;
  }

  .cursor {
    display: inline-block;
    width: 0.5ch;
    height: 0.85em;
    background: var(--teal);
    margin-left: 0.15ch;
    vertical-align: text-bottom;
    opacity: 0;
    animation:
      appear 0.1s linear 1.15s forwards,
      blink 0.9s step-end 1.25s infinite;
  }

  @keyframes reveal {
    to {
      clip-path: inset(0 0 -0.2em 0);
    }
  }

  @keyframes appear {
    to {
      opacity: 1;
    }
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .line {
      clip-path: none;
      animation: none;
    }
    .cursor {
      opacity: 1;
      animation: none;
    }
  }

  .sub {
    margin-top: 1.5rem;
    max-width: 42ch;
    color: var(--cloud);
    font-size: 1.05rem;
  }

  .ctas {
    margin-top: 2rem;
    display: flex;
    gap: 0.85rem;
    flex-wrap: wrap;
  }

  .shot {
    display: block;
    margin-top: 3.5rem;
    width: 100%;
    height: auto;
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 30px 80px -24px rgba(0, 0, 0, 0.7);
  }
</style>
