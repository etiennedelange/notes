---
import { REPO_URL, type ReleaseInfo } from "../lib/github";

interface Props {
  release: ReleaseInfo | null;
}

const { release } = Astro.props;
---

<section class="hero" id="top">
  <div class="hero-inner">
    <p class="kicker">a desktop editor for .txt and .md files</p>
    <h1 class="line">
      point it at a file and start typing.<span class="cursor" aria-hidden="true"
      ></span>
    </h1>
    <p class="sub">
      No vault. No index. No project to set up. Notes opens instantly and gets
      out of the way — built for the files you already have, not a workspace
      it wants to manage for you.
    </p>
    <div class="ctas">
      <a class="btn btn-primary" href="#download">{release ? "Download Notes" : "Get Notes"}</a>
      <a class="btn btn-ghost" href={REPO_URL}>View source</a>
    </div>

    <div class="mock" role="img" aria-label="Notes editor window showing three open tabs, one with unsaved changes, and a status bar">
      <div class="mock-tabs">
        <span class="tab tab-active">todo.md<span class="dirty-dot" aria-hidden="true"></span></span>
        <span class="tab">ideas.md</span>
        <span class="tab">scratch.txt</span>
      </div>
      <div class="mock-body">
        <span class="mock-line"></span>
        <span class="mock-line"></span>
        <span class="mock-line"></span>
        <span class="mock-line mock-line--accent"></span>
        <span class="mock-line"></span>
      </div>
      <div class="mock-status">
        <span>~/notes/todo.md</span>
        <span>Markdown · Tokyo Night</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: clamp(2rem, 6vw, 3.5rem) var(--gutter) clamp(3rem, 8vw, 5rem);
  }

  .hero-inner {
    max-width: var(--wide-width);
    margin: 0 auto;
  }

  .kicker {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--cloud);
  }

  .line {
    margin-top: 1.1rem;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: clamp(1.9rem, 4.6vw, 3.1rem);
    line-height: 1.3;
    color: var(--paper);
    max-width: 17ch;
    clip-path: inset(0 100% -0.2em 0);
    animation: reveal 1s cubic-bezier(0.16, 0.84, 0.44, 1) 0.25s forwards;
  }

  .cursor {
    display: inline-block;
    width: 0.5ch;
    height: 0.85em;
    background: var(--teal);
    margin-left: 0.15ch;
    vertical-align: text-bottom;
    opacity: 0;
    animation:
      appear 0.1s linear 1.15s forwards,
      blink 0.9s step-end 1.25s infinite;
  }

  @keyframes reveal {
    to {
      clip-path: inset(0 0 -0.2em 0);
    }
  }

  @keyframes appear {
    to {
      opacity: 1;
    }
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .line {
      clip-path: none;
      animation: none;
    }
    .cursor {
      opacity: 1;
      animation: none;
    }
  }

  .sub {
    margin-top: 1.5rem;
    max-width: 42ch;
    color: var(--cloud);
    font-size: 1.05rem;
  }

  .ctas {
    margin-top: 2rem;
    display: flex;
    gap: 0.85rem;
    flex-wrap: wrap;
  }

  .mock {
    margin-top: 3.5rem;
    max-width: 30rem;
    border-radius: 10px;
    overflow: hidden;
    background: var(--navy-raised);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 24px 60px -20px rgba(0, 0, 0, 0.6);
  }

  .mock-tabs {
    display: flex;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .tab {
    padding: 0.75rem 1.1rem;
    color: var(--cloud);
    border-right: 1px solid rgba(255, 255, 255, 0.06);
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .tab-active {
    color: var(--paper);
    background: rgba(255, 255, 255, 0.03);
  }

  .dirty-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--teal);
  }

  .mock-body {
    padding: 1.25rem 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .mock-line {
    height: 8px;
    border-radius: 5px;
    background: rgba(255, 255, 255, 0.09);
  }

  /* Fixed widths per line, baked into CSS (rather than inline `style`
     attributes) so the page's Content-Security-Policy style-src doesn't
     need to allow inline styles. */
  .mock-line:nth-child(1) {
    width: 62%;
  }

  .mock-line:nth-child(2) {
    width: 84%;
  }

  .mock-line:nth-child(3) {
    width: 38%;
  }

  .mock-line:nth-child(4) {
    width: 51%;
  }

  .mock-line:nth-child(5) {
    width: 70%;
  }

  .mock-line--accent {
    background: var(--teal-dim);
  }

  .mock-status {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.3rem 0.75rem;
    padding: 0.55rem 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--cloud);
    background: rgba(0, 0, 0, 0.2);
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }
</style>
