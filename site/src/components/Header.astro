---
import { REPO_URL } from "../lib/github";
---

<header class="header">
  <a class="wordmark" href="#top">
    <span class="dot" aria-hidden="true"></span>
    notes
  </a>
  <nav class="nav">
    <a href="#features">Features</a>
    <a href="#themes">Themes</a>
    <a href="#download">Download</a>
    <a href={REPO_URL}>GitHub</a>
  </nav>
</header>

<style>
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.5rem var(--gutter);
    max-width: var(--wide-width);
    margin: 0 auto;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 1.05rem;
    text-decoration: none;
    color: var(--paper);
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--teal);
    box-shadow: 0 0 8px 1px var(--teal-dim);
  }

  .nav {
    display: flex;
    gap: clamp(1rem, 3vw, 2rem);
    font-size: 0.9rem;
  }

  .nav a {
    text-decoration: none;
    color: var(--cloud);
    transition: color 0.15s ease;
  }

  .nav a:hover {
    color: var(--paper);
  }

  @media (max-width: 30rem) {
    .nav {
      gap: 0.85rem;
    }
  }
</style>
