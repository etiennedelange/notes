{
  "enabledPlugins": {
    "personal-context@personal-context": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/design-system-reminder.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
